# Copy to an env file outside the checkout. Never commit real credentials.
JGW_TENANT=__PLACEHOLDER_TENANT__
JGW_PUBLIC_ORIGIN=https://gw.__PLACEHOLDER_TENANT__.jgw.test
KC_PUBLIC_URL=https://auth.jgw.test
JGW_CLIENT_SECRET=__PLACEHOLDER_CLIENT_SECRET__
JAUTH_PUBLIC_URL=https://jauth.jgw.test
JGW_SERVICE_KEY=__PLACEHOLDER_TENANT_SERVICE_KEY__
JGW_PORT=54233
JGW_DB_HOST=127.0.0.1
JGW_DB_PORT=54232
JGW_DB_NAME=jgw_groupware
JGW_DB_USER=jgw_groupware
JGW_DB_PASSWORD=__PLACEHOLDER_DATABASE_PASSWORD__
JGW_TLS_CERTIFICATE=/external/runtime/tls/server.crt
JGW_TLS_KEY=/external/runtime/tls/server.key
# Trust the private Keycloak CA in this process, not the operating system.
NODE_EXTRA_CA_CERTS=/external/runtime/tls/keycloak-ca.crt
# Optional downstream endpoints: explicit loopback ports, never 3001.
# JGW_SERVICE_MAIL_URL=http://127.0.0.1:54240
# JGW_SERVICE_MESSENGER_URL=http://127.0.0.1:54241

# JGW_SERVICE_APPROVAL_URL=https://127.0.0.1:54242
