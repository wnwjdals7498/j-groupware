# Inactive template only; the explicit one-shot CLI exists, but native host service activation is pending.
[Unit]
Description=Reconcile j-groupware desired subscriptions every minute

[Timer]
OnBootSec=60s
OnUnitActiveSec=60s
AccuracySec=1s
Unit=jgw-provision-agent.service

[Install]
WantedBy=timers.target
