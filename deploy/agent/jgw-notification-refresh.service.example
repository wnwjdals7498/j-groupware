# Inactive source example. Supply external control files and authorize host setup separately.
[Unit]
Description=Refresh j-groupware authoritative notification lease
After=network.target postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/node /opt/jgw/bundles/j-groupware/deploy/agent/notification-worker.mjs --config /etc/jgw/notification/control.json --once
TimeoutStartSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jgw/provision/notification
