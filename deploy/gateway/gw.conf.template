limit_req_zone $binary_remote_addr zone=${GW_ZONE}_req:1m rate=${GW_RATE}r/s;
limit_conn_zone $binary_remote_addr zone=${GW_ZONE}_conn:1m;
server {
    listen ${GW_BIND}:${GW_HTTP_PORT};
    server_name gw.${GW_TENANT}.jgw.test;
    return 308 https://gw.${GW_TENANT}.jgw.test${GW_PUBLIC_PORT}$request_uri;
}
server {
    listen ${GW_BIND}:${GW_HTTPS_PORT} ssl;
    server_name gw.${GW_TENANT}.jgw.test;
    ssl_certificate ${GW_CERT};
    ssl_certificate_key ${GW_KEY};
    include ${GW_ROOT}/snippets/tls.conf;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req_log_level notice;
    limit_conn_log_level notice;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_ssl_server_name on;
    proxy_ssl_name gw.${GW_TENANT}.jgw.test;
    proxy_ssl_trusted_certificate ${GW_UPSTREAM_CA};
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_connect_timeout 5s;
    proxy_read_timeout 90s;
    proxy_send_timeout 30s;
    proxy_buffering off;
    location = /internal {
        add_header X-JGW-Gateway-Config "${GW_GENERATION}" always;
        return 404;
    }
    location ^~ /internal/ { return 404; }
${GW_EXT_ROUTES}
    location /ext/ {
        limit_req zone=${GW_ZONE}_req burst=${GW_BURST} nodelay;
        limit_conn ${GW_ZONE}_conn ${GW_CONNECTIONS};
        root ${GW_ROOT}/denied;
        try_files /__no_public_content__ =404;
    }
    location / {
        proxy_pass https://127.0.0.1:${GW_BFF_PORT};
    }
}
