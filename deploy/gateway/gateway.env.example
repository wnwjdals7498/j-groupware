# External file only. No credential values in this profile.
JGW_TENANT=customer-a
JGW_GATEWAY_ALLOWED_TENANTS=customer-a
JGW_GATEWAY_SERVICES=j-talk,j-customer-auth-db
JGW_GATEWAY_BIND=0.0.0.0
JGW_GATEWAY_HTTP_PORT=80
JGW_GATEWAY_HTTPS_PORT=443
JGW_PORT=54233
JCADB_INTERNAL_PORT=54260
JTALK_INTERNAL_PORT=54261
# Services may use loopback HTTP or certificate-verified HTTPS.
JCADB_INTERNAL_PROTOCOL=http
JTALK_INTERNAL_PROTOCOL=http
JGW_TLS_CERTIFICATE=/etc/jgw/tls/certificate.pem
JGW_TLS_KEY=/etc/jgw/tls/private-key.pem
JGW_GATEWAY_UPSTREAM_CA=/etc/jgw/tls/ca.pem
JGW_EXT_RATE=10
JGW_EXT_BURST=20
JGW_EXT_CONNECTIONS=20
